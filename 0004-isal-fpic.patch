From: Bernhard Rosenkränzer <bero@lindev.ch>
Subject: Build ISA-L static libraries with -fPIC

slibtool ignores --with-pic, so libisal.a is not position-independent
and cannot be linked into libec_isa.so. isa-l_crypto's static archive
has the same problem when linked into ceph_crypto_isal.

diff --git a/cmake/modules/BuildISAL.cmake b/cmake/modules/BuildISAL.cmake
index 9b0d6ce..b2e6b93 100644
--- a/cmake/modules/BuildISAL.cmake
+++ b/cmake/modules/BuildISAL.cmake
@@ -27,10 +27,10 @@ function(build_isal)
   if(CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|AARCH64|arm64|ARM64")
     list(APPEND arm_cflags "-Wa,-march=armv8-a+sve")
   endif()
-  if(arm_cflags)
-    string(REPLACE ";" " " arm_cflags_str "${arm_cflags}")
-    list(APPEND configure_cmd "CFLAGS=$ENV{CFLAGS} -fPIC ${arm_cflags_str}")
-  endif()
+  # slibtool ignores --with-pic, so the static archive is not PIC unless
+  # CFLAGS says so. libec_isa.so links that archive.
+  string(REPLACE ";" " " arm_cflags_str "${arm_cflags}")
+  list(APPEND configure_cmd "CFLAGS=$ENV{CFLAGS} -fPIC ${arm_cflags_str}")
 
   include(ExternalProject)
   ExternalProject_Add(isal_ext
diff --git a/src/crypto/isa-l/isa-l_crypto/make.inc b/src/crypto/isa-l/isa-l_crypto/make.inc
index a4f714f..8d40271 100644
--- a/src/crypto/isa-l/isa-l_crypto/make.inc
+++ b/src/crypto/isa-l/isa-l_crypto/make.inc
@@ -110,7 +110,7 @@ ifeq ($(arch),noarch)
   host_cpu=base_aliases
 endif
 INCLUDE   = $(patsubst %,-I%/,$(subst :, ,$(VPATH))) -Iinclude/ -Iinclude/isa-l_crypto/ -Iinclude/internal/
-CFLAGS   = $(CFLAGS_$(arch)) $(CFLAGS_$(CC)) $(DEBUG) -O2 $(DEFINES) $(INCLUDE)
+CFLAGS   = -fPIC $(CFLAGS_$(arch)) $(CFLAGS_$(CC)) $(DEBUG) -O2 $(DEFINES) $(INCLUDE)
 ASFLAGS  = $(ASFLAGS_$(arch)) $(ASFLAGS_$(CC)) $(DEBUG_$(AS)) $(DEFINES) $(INCLUDE)
 ARFLAGS  = $(ARFLAGS_$(arch))
 DEFINES += $(addprefix -D , $D)
